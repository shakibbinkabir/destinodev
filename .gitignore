node_modules/
dist/

# .env.local stays out of git; .env.development and .env.production are
# committed because they hold no secrets — only the public API base URL
# and brand color tokens.
.env.local
.env.*.local

# Laravel backend (defensive — backend/.gitignore is also in place)
backend/vendor/
backend/node_modules/
backend/.env
backend/storage/*.log
backend/storage/logs/*.log
backend/storage/framework/cache/data/
backend/storage/framework/sessions/
backend/storage/framework/views/
backend/database/*.sqlite
backend/database/*.sqlite-journal
backend/bootstrap/cache/*.php

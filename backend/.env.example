APP_NAME=Destino
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.destinocojp.com

APP_TIMEZONE=Asia/Tokyo
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Production uses MySQL (Hostinger-provided). For local dev override to:
#   DB_CONNECTION=sqlite
#   DB_DATABASE=database/database.sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

# Mail: SMTP via Hostinger by default. For local dev, set MAIL_MAILER=log.
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=noreply@destino.jp
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@destino.jp"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_INQUIRY_TO=export@destino.jp

# External integrations. Replace blank values before exercising those endpoints.
# USD→JPY rate is scraped from MUFG Bank (no API key). The customer-facing rate
# is `USD T.T.B. − EXCHANGE_RATE_TTB_OFFSET`. Refreshed every 3h by the
# `exchange-rate:sync` scheduled command. Both vars are optional (defaults shown).
EXCHANGE_RATE_MUFG_URL=https://www.bk.mufg.jp/ippan/kinri/list_j/kinri/kawase.html
EXCHANGE_RATE_TTB_OFFSET=4
# YouTube channel feed (no API key — public RSS via youtube.com/feeds/videos.xml).
YOUTUBE_CHANNEL_ID=UC9r_ugFs9RL4OkeEAwztQ7g

# JDMAuction OnePrice stock API (PRD §6.4.3).
# Base URL is the path prefix shared by /search-auction and /lot-detail.
# Auth is via two custom headers (username + api-key) — NOT bearer token.
# ONE_PRICE_STOCK_MAKERS is a CSV of maker.company_id values to iterate on
# scheduled runs (see backend/database/data/oneprice/makers.json — e.g. 9=TOYOTA,
# 2=HONDA, 6=NISSAN). Leave blank and the scheduled sync becomes a no-op; use
# `php artisan stock:sync --maker=9 --model=718` for ad-hoc fetches.
ONE_PRICE_STOCK_API_URL=https://jdmauction.live/oneprice/api
ONE_PRICE_STOCK_API_USERNAME=
ONE_PRICE_STOCK_API_KEY=
ONE_PRICE_STOCK_MAKERS=

# CORS + Sanctum: production frontend domain.
FRONTEND_URL=https://destinocojp.com
SANCTUM_STATEFUL_DOMAINS=destinocojp.com

VITE_APP_NAME="${APP_NAME}"
